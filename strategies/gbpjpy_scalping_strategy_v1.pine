
//@version=6
strategy("AI GBPJPY Scalping Strategy V1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.01, slippage=2)

// INPUT SETTINGS
fastLength = input.int(9, "Fast EMA")
slowLength = input.int(21, "Slow EMA")
rsiLength = input.int(14, "RSI Length")
atrLength = input.int(14, "ATR Length")
atrMultiplier = input.float(1.5, "ATR Stop Loss Multiplier")
riskReward = input.float(2.0, "Risk Reward Ratio")

// INDICATORS
fastEMA = ta.ema(close, fastLength)
slowEMA = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

// BUY AND SELL CONDITIONS
buySignal = ta.crossover(fastEMA, slowEMA) and rsiValue > 50 and barstate.isconfirmed
sellSignal = ta.crossunder(fastEMA, slowEMA) and rsiValue < 50 and barstate.isconfirmed

// STOP LOSS DISTANCE
stopDistance = atrValue * atrMultiplier

// BUY TRADE
if buySignal and strategy.position_size == 0
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=close - stopDistance, limit=close + stopDistance * riskReward)

// SELL TRADE
if sellSignal and strategy.position_size == 0
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=close + stopDistance, limit=close - stopDistance * riskReward)

// EMA LINES
plot(fastEMA, title="Fast EMA", color=color.teal, linewidth=2)
plot(slowEMA, title="Slow EMA", color=color.orange, linewidth=2)

// BUY AND SELL LABELS
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white)
